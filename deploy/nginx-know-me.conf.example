# 放到 ECS：/etc/nginx/conf.d/know-me.conf
# 证书路径按实际修改；server_name 改为你的 chat 域名。

upstream know_me_upstream {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name chat.example.com;

    ssl_certificate     /etc/nginx/ssl/chat.fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/chat.privkey.pem;

    # 简易限流（按需调整）
    limit_req_zone $binary_remote_addr zone=km_chat:10m rate=3r/s;

    location / {
        limit_req zone=km_chat burst=20 nodelay;

        proxy_pass http://know_me_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # SSE / 长推理
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    server_name chat.example.com;
    return 301 https://$host$request_uri;
}
