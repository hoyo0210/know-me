# 放到 /opt/know-me/docker-compose.yml
# 目录结构：
#   /opt/know-me/
#     docker-compose.yml  (.env 同目录)
#     src/                 # git clone 的 know-me 源码
#     corpus/ persona/ data/

services:
  know-me:
    build: ./src
    restart: unless-stopped
    ports:
      - "127.0.0.1:8000:8000"
    env_file:
      - .env
    environment:
      KNOW_ME_CORPUS_ROOT: /data/corpus
      KNOW_ME_PERSONA_DIR: /data/persona
      KNOW_ME_CHAT_SQLITE_PATH: /data/chat.sqlite
    volumes:
      - ./corpus:/data/corpus:ro
      - ./persona:/data/persona:ro
      - ./data:/data
