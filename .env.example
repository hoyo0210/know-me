# Know Me — 复制为 .env 后按需填写；勿将含密钥的 .env 提交到 Git。

# E01：语料根目录（默认 `corpus/`；其下**每个一级子目录**递归收录 .md，无需固定目录名；CLI `--corpus-root` 优先于本变量）
# KNOW_ME_CORPUS_ROOT=corpus

# 人设目录（默认仓库根 persona/，须含 IDENTITY.md、SOUL.md；persona/ 默认 Git 忽略，克隆后从 persona.example 复制或设为本变量）
# KNOW_ME_PERSONA_DIR=

# OpenAI 兼容根路径（须含 /v1）：LM Studio 默认端口示例
KNOW_ME_OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# 嵌入模型 id（建索引 know-me-index build-index 与检索 query 必填且须一致）
KNOW_ME_OPENAI_EMBED_MODEL=

# 对话模型 id（know-me query 必填；可与嵌入模型不同）
KNOW_ME_OPENAI_CHAT_MODEL=

# 可选：Bearer Token（OpenAI SDK 与 LM Studio 示例常为 lm-studio；须与服务端「API Key」一致；未鉴权可留空）
KNOW_ME_OPENAI_API_KEY=

# 可选：嵌入批大小、检索 Top-K、采样温度
# KNOW_ME_OPENAI_EMBED_BATCH_SIZE=32
# KNOW_ME_RAG_TOP_K=5
# KNOW_ME_LLM_TEMPERATURE=0.2

# E03：`know-me serve` 多轮会话保留轮数（一轮 ≈ user + assistant）
# KNOW_ME_CHAT_HISTORY_MAX_TURNS=6

# E03：Agent 发往对话网关的 messages 粗估字符上限（含 system；防「Context size exceeded」）
# 完整 system+tools 常 >12k；8k 模型建议 6000～8000 并开启 AUTO_SLIM；32k 模型可 28000+
# KNOW_ME_AGENT_CONTEXT_CHAR_BUDGET=12000

# E03：system+tools 接近预算时自动用精简 system（去掉 few-shot 与长篇阶段说明）
# KNOW_ME_AGENT_SYSTEM_AUTO_SLIM=1

# LM Studio + Qwen3.5 等：带 tools 且多轮 user 时 Jinja 易报 No user query found。
# 默认在本地网关且模型名含 qwen 时自动折叠为 system+单 user；设 0 关闭，设 1 强制开启。
# KNOW_ME_LMSTUDIO_QWEN_COMPAT=1

# Agent 编排使用 LangChain create_agent（LangGraph）；经 nginx 反代时建议 proxy_read_timeout ≥ 300s

# E03：滑动窗口 — 送入模型的最近原文轮数（更早轮次写入会话摘要）
# KNOW_ME_AGENT_CONTEXT_WINDOW_TURNS=3

# E03：会话摘要（默认 lazy=下轮开始前且积压≥MIN 字才更新；after_turn=每轮结束后；off=关）
# KNOW_ME_AGENT_SUMMARY_ENABLED=1
# KNOW_ME_AGENT_SUMMARY_MODE=lazy
# KNOW_ME_AGENT_SUMMARY_MAX_CHARS=900
# KNOW_ME_AGENT_SUMMARY_RAG_ENABLED=0
# KNOW_ME_AGENT_SUMMARY_MIN_TRANSCRIPT_CHARS=120
# KNOW_ME_AGENT_SUMMARY_RAG_MAX_CHARS=2400
# KNOW_ME_AGENT_SUMMARY_TIMEOUT_SEC=90

# E03：单次检索写入 tool 消息的最大字符数，超出截断
# KNOW_ME_AGENT_TOOL_RESULT_MAX_CHARS=4800

# E03：会话前若干轮「快会话」——压缩检索与工具上下文以尽量降低延迟（整轮是否 <2s 仍依赖网关/模型；可选硬超时）
# KNOW_ME_AGENT_FAST_SESSION_TURNS=10
# KNOW_ME_AGENT_FAST_TOP_K=3
# KNOW_ME_AGENT_FAST_DISABLE_HR_BOOST=true
# KNOW_ME_AGENT_FAST_TOOL_RESULT_MAX_CHARS=2400
# KNOW_ME_AGENT_FAST_MAX_TOOL_ROUNDS=3
# KNOW_ME_AGENT_FAST_LLM_TIMEOUT_SEC=
# 若经 nginx 反代访问，建议 proxy_read_timeout ≥ 300s；SSE 阻塞时服务端每 12s 发 keepalive

# KNOW_ME_SSE_KEEPALIVE_SEC=12

# E03：会话写入 SQLite（默认 data/chat.sqlite，与 Chroma 同目录习惯）；设 0 则仅内存、重启丢失
# KNOW_ME_CHAT_SQLITE_ENABLED=1
# KNOW_ME_CHAT_SQLITE_PATH=data/chat.sqlite

# E03：公网地址栏在子路径下（如 /knowme/）时必填：与栏上一致的前缀，如 /knowme。nginx 已把 upstream 剥成根路径时仍须设，否则前端会请求错路径
# KNOW_ME_HTTP_BROWSER_PREFIX=

# E03：聊天页「简历」按钮外链（可选；未设置时为空，不注入个人域名）
# KNOW_ME_RESUME_BROWSER_URL=https://example.com

# E03：仅当 nginx **未**剥离、请求仍以 /foo/chat 到达本进程时，设与线上一致的前缀以挂载 ASGI（常与 KNOW_ME_HTTP_BROWSER_PREFIX 同值）
# KNOW_ME_HTTP_ROOT_PATH=

# E03：`POST /ingest` 的 Bearer 密钥；未设置则该接口返回 503
# KNOW_ME_INGEST_API_KEY=

# E04：对外免责声明（`know-me chat` 开场 stderr、`POST /chat` 的 session/done 与 JSON 字段 disclaimer）
# KNOW_ME_DISCLAIMER=

# E04：HR 类问句是否扩大检索并对 hr_faq / hr_screening 片段优先重排（默认 true；设 0 关闭）
# KNOW_ME_RAG_HR_BOOST=true

# E05：向 stderr 输出单行 JSON 运行追踪（用户问题、chunk_id、模型名、延迟、token 用量等）
# KNOW_ME_STRUCTURED_TRACE=1

# E05：`POST /feedback` 写入 JSONL；启用后请仅在内网或受信环境暴露
# KNOW_ME_FEEDBACK_ENABLED=1
# KNOW_ME_FEEDBACK_LOG=data/feedback.jsonl
