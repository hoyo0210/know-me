# Know Me — 索引构建（E01）嵌入：OpenAI 兼容 HTTP
# 复制为 .env 后按需修改；不要将含密钥的 .env 提交到 Git。

# LM Studio 默认 OpenAI 兼容根路径（须含 /v1）
KNOW_ME_OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# 在 LM Studio / 服务端中选定的嵌入模型 id（必填）
KNOW_ME_OPENAI_EMBED_MODEL=

# 云端兼容网关若需要 Bearer Token 再填写
KNOW_ME_OPENAI_API_KEY=

# 可选：单请求批量大小
# KNOW_ME_OPENAI_EMBED_BATCH_SIZE=32
